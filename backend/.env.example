# ---- Database: your MySQL user, password, host, port and database name (npm run db:setup creates the database) ----
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/upshift_dashboard"

# ---- Server ----
PORT=4100
# The dashboard's address (comma-separated for several), allowed to call this API from the browser
CORS_ORIGIN="http://localhost:3000"
# Long random string used to sign sign-in tokens. Change it to sign everyone out.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
JWT_EXPIRES_IN="12h"

# ---- Google Sheets feed (the Apps Script web app from apps-script/README.md) ----
APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbzD0KxrO9YTbZznuemzXRjlnsiFPY7wDZgYvPm3TFh7R102ZLbN6qmIMovSNp8iSTEOgg/exec"
APPS_SCRIPT_PASSWORD="YOUR_APPS_SCRIPT_PASSWORD"
SYNC_INTERVAL_MINUTES=5

# ---- The dashboard login (one admin). Change here and restart the backend to change it. ----
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe@123"

# ---- Mobile OTP (Idea Challenge page). "spear" = real SMS via Spear UC (login4.spearuc.com) with our DLT-approved template (we make and check the code). "console" = testing: no SMS, the code is printed in this terminal and in the browser console. ----
OTP_PROVIDER=console
# Spear UC API key (authKey, Spear UC dashboard). Keep it secret: never put it in frontend code.
SMS_API_KEY=
# DLT sender id the OTP template is approved under
SMS_SENDER=UPSHFT
# DLT template id of the OTP text (t_id)
SMS_TEMPLATE_ID=1777179189995473839
# "true" = the mobile number must be verified with a code before an idea can be sent
OTP_REQUIRED=true
# Console mode only (testing): every number gets this code. Ignored with spear.
OTP_FIXED_CODE=

# ---- Winter Arc AI Idea Challenge (Day 1 is set with Start / Stop in the dashboard's Winter Arc page) ----
# Most entries the team can shortlist for the live Zoom discussion each day (start with 3 to 5)
ARC_SHORTLIST_PER_DAY=5
